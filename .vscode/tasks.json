{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run batch file",
            "type": "shell",
            "command": "${input:batchFile}",
            "windows": {
                "command": "${input:batchFile}"
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ],
    "inputs": [
        {
            "id": "batchFile",
            "type": "promptString",
            "description": "Enter the path to the .bat file to run",
            "default": "${workspaceFolder}/scripts/IsolatedRevit2025Launcher.bat"
        }
    ]
}